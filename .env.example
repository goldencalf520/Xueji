# ─────────────────────────────────────────────────────────────────────────────
# 环境变量登记表（服务端读取 apps/server/.env）。真实密钥只放云密钥管理 / CI Secret，严禁提交。
# 规划中的全部变量已预先登记；各模块在自己目录内用 zod 校验需要的变量。
# 新增变量：在对应分组末尾追加一行并注明负责模块（只追加，冲突时保留双方）。
# ─────────────────────────────────────────────────────────────────────────────

# —— 核心（src/config/app.config.ts）——
NODE_ENV=development
APP_ROLE=api
PORT=3000
LOG_LEVEL=info
DATABASE_URL=mysql://root:root@localhost:3306/xueji
SHADOW_DATABASE_URL=mysql://root:root@localhost:3306/xueji_shadow
REDIS_URL=redis://localhost:6379
PUBLIC_API_BASE_URL=http://localhost:3000
OPENAPI_ENABLED=true

# —— 令牌（common/auth）：三端签名密钥相互独立 ——
JWT_APP_SECRET=change-me-app
JWT_ADMIN_SECRET=change-me-admin
JWT_HOSPITAL_SECRET=change-me-hospital
JWT_ACCESS_TTL=2h
JWT_APP_REFRESH_TTL=30d
JWT_STAFF_REFRESH_TTL=12h

# —— 字段加密（common/crypto，§11.4）：dev 用本地密钥，staging/prod 用 KMS ——
CRYPTO_PROVIDER=local
CRYPTO_LOCAL_DATA_KEY=base64:0000000000000000000000000000000000000000000=
CRYPTO_HMAC_KEY=base64:0000000000000000000000000000000000000000000=
TENCENT_KMS_REGION=ap-guangzhou
TENCENT_KMS_KEY_ID=
TENCENT_KMS_ENCRYPTED_DATA_KEY=

# —— 腾讯云通用凭证（COS / KMS / SMS / ASR / TTS / 内容安全 共用子账号，按最小权限授权）——
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# —— 文件存储（modules/file）：dev 用 MinIO，staging/prod 用 COS ——
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=ap-guangzhou
STORAGE_BUCKET_PRIVATE=xueji-private
STORAGE_BUCKET_PUBLIC=xueji-public
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_SIGNED_URL_TTL_SECONDS=600

# —— 微信小程序（modules/wechat）——
WX_APPID=
WX_SECRET=
WX_ENV_VERSION=develop

# —— 企业微信（modules/wecom）——
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
WECOM_CONTACT_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
WECOM_ROBOT_WEBHOOK=
WECOM_OAUTH_REDIRECT=http://localhost:5173/mobile.html

# —— 短信（modules/notify，§13.5：只发服务通知）——
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_LOGIN_CODE=
SMS_TEMPLATE_CHECKUP_REMIND=

# —— 大模型（packages/ai + modules/ai，§10.2）：OpenAI 兼容接口，已备案模型 ——
AI_BASE_URL=
AI_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_ENABLED=false
AI_MONTHLY_BUDGET_CNY=0

# —— 语音与内容安全（modules/speech、modules/ai）——
TENCENT_ASR_ENGINE_ZH=16k_zh
TENCENT_ASR_ENGINE_YUE=16k_yue
TENCENT_TTS_VOICE_ZH=
TENCENT_TTS_VOICE_YUE=
TENCENT_TMS_BIZTYPE=

# —— 管理端 / 医院端前端（apps/admin，构建时注入）——
VITE_API_BASE=/api/v1

# —— 队列与定时任务（common/queue，SRV-08）—— REDIS_URL 复用上方核心分组 ——
QUEUE_PREFIX=xueji
QUEUE_CONCURRENCY=4
QUEUE_TZ=Asia/Shanghai
