{
  "name": "@xueji/miniapp",
  "version": "0.0.0",
  "private": true,
  "description": "用户端微信小程序（uni-app Vue 3）：客户与家人使用，支持乐龄模式",
  "scripts": {
    "dev": "uni -p mp-weixin",
